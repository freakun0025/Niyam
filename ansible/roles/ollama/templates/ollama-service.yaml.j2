apiVersion: v1
kind: Service
metadata:
  name: ollama
  namespace: {{ niyam_ns }}
  labels:
    app.kubernetes.io/part-of: niyam
spec:
  # No selector: the EndpointSlice points this Service at Ollama on the host.
  type: ClusterIP
  ports:
    - name: http
      protocol: TCP
      port: {{ ollama_port }}
      targetPort: {{ ollama_port }}
