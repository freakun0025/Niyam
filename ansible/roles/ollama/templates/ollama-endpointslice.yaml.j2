apiVersion: discovery.k8s.io/v1
kind: EndpointSlice
metadata:
  name: ollama-host
  namespace: {{ niyam_ns }}
  labels:
    kubernetes.io/service-name: ollama
    endpointslice.kubernetes.io/managed-by: niyam-ansible
    app.kubernetes.io/part-of: niyam
addressType: IPv4
ports:
  - name: http
    protocol: TCP
    port: {{ ollama_port }}
endpoints:
  - addresses:
      - "{{ ollama_host_ip }}"
    conditions:
      ready: true
